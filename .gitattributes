# Arquivos consumidos por Linux (runner do CI, container) sempre em LF.
# Sem isso o Git no Windows commita CRLF e o bash reclama de $'\r'.
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
mvnw            text eol=lf

# Scripts que rodam no Windows mantem CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
